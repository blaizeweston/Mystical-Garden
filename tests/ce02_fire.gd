extends SceneTree
const Case=preload("res://tests/support/affinity_card_case.gd")
const Fire=preload("res://fire_combat.gd")
const Frost=preload("res://frost_combat.gd")
const Sources=preload("res://affinity_status_source.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE02 Fire: ",label)
func run():
 c.create(self)
 for definition: Dictionary in c.Catalog.DEFINITIONS.values():
  if not definition.has("family") or definition.policy!="stackable":continue
  var label: String=c.Catalog.contribution_label(definition)
  check(not label.is_empty() and not label.contains("milli") and not label.contains("_"),"expanded card preview uses an authored human-readable contribution label")
  for value in definition.values:
   check(not c.Catalog.effect_text(definition,int(value)).contains("%s"),"each rarity resolves its actual contribution text")
 var g: Node=c.game
 var now:=preload("res://combat_clock.gd").now()
 c.equip(1,"fire")
 c.own(1,["kindled_roots","feeding_the_flames","lingering_coals","lingering_coals"])
 var event:=c.action(1,"core")
 Fire.ignite(g,event,-1,now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])==19,"Core and affinity application copies add their real stacks")
 var skill: Dictionary=g.combat_build(g.players[1]).core_skill()
 check(int(skill.lifetime_ms)==Fire.FIELD_MS+750+500,"Lingering Coals extends the actual scheduled Core lifetime")
 var cast:={"grown":false,"center":g.tactics.position,"forward":Vector3.FORWARD,"cast_origin":Vector3.ZERO,"owner":1,"skill":skill,"affinity_action":event}
 Fire.field(g,cast,now)
 check(cast.field_until==Fire.FIELD_MS+500,"actual Ember trail and its visual duration use the acquired contribution")
 c.reset();c.equip(1,"fire",["form"])
 c.own(1,["stoking_strikes","feverish_tempo"])
 c.action(1,"form").publish(g,"weapon_contact","one","leader",now,{"enemy":-1})
 event=c.action(1,"form")
 event.publish(g,"weapon_contact","two","leader",now+100,{"enemy":-1})
 var status: Dictionary=g.tactics.memory[Fire.BURNING]
 check(Fire.count(status)==17 and Fire.tempo_percent(g,g.players[1],now+101)==3,"successive hits add one more stack and a real temporary speed benefit")
 var old_count:=Fire.count(status)
 event.publish(g,"weapon_contact","two","leader",now+100,{"enemy":-1})
 check(Fire.count(status)==old_count,"duplicate ordinary contact cannot build another sequence step or Burning application")
 var port:=preload("res://weapon_attack_world.gd").new(g)
 var attack: Dictionary=port.capture_attack(1,now+101)
 var baseline: int=g.combat_build(g.players[1]).basic_stats().interval
 check(attack.interval==Fire.interval_with_tempo(baseline,3) and int(attack.interval)<baseline,"real attack capture uses the resolved temporary interval")
 var ui:=preload("res://ui/gameplay/player_build_projection.gd").summary(g.run_summary_ui_data(1))
 check(ui.totals.any(func(row):return row[0]=="Attack speed" and row[1]==g.Life.Preview.attack_speed(int(attack.interval))+" attacks/sec"),"Stats shows the same actual attack speed")
 check(Fire.tempo_percent(g,g.players[1],now+2201)==0,"temporary speed expires independently of the hit sequence")
 var capped: Dictionary=g.combat_build(g.players[1]).weapon_base_stats()
 capped.interval=230
 check(not c.Cards.ledger(g.players[1]).eligible(capped,g.DODGE_COOLDOWN_MS).has("feverish_tempo"),"a permanently capped weapon is not offered ineffective Tempo")
 c.reset();c.equip(1,"fire",["catalyst"])
 c.own(1,["incendiary_followthrough","ember_resonance"])
 var side:=c.scout(Vector3(1,0,-2))
 event=c.action(1,"catalyst")
 Fire.ignite(g,event,-1,now)
 check(Fire.count(g.encounter.scout(side)[Fire.BURNING])==1,"Catalyst resonance creates a real reduced nearby application")
 Fire.ignite(g,event,-1,now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])==26 and Fire.count(g.encounter.scout(side)[Fire.BURNING])==1,"already-Burning bonus is real; one class action cannot repeat resonance")
 c.reset();c.equip(1,"fire");c.own(1,["banked_heat"])
 Fire.ignite(g,c.action(1,"core"),-1,now)
 Fire.tick(g,c.Clock.advance(g,.5),now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])==9,"one Common retention copy saves a real stack at baseline intensity")
 c.reset();c.equip(1,"fire");c.own(1,["banked_heat","banked_heat","banked_heat","banked_heat"],3)
 Fire.ignite(g,c.action(1,"core"),-1,now)
 Fire.tick(g,c.Clock.advance(g,.5),now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])==12,"four Epic retention copies preserve more intensity without removing decay")
 c.reset();c.equip(1,"fire",["form"]);c.own(1,["flashover"])
 side=c.scout(Vector3(1,0,-2))
 var before:int=g.encounter.hp(side)
 Fire.ignite(g,c.action(1,"form"),-1,now)
 status=g.tactics.memory[Fire.BURNING]
 check(Fire.count(status)==6 and g.encounter.hp(side)==before-1,"Flashover consumes two actual stacks, keeps six and deals one Common damage")
 check(not g.encounter.scout(side).has(Fire.BURNING),"Flashover deals damage rather than spreading Burning")
 var before_second:int=g.encounter.hp(side)
 c.equip(2,"fire",["form"]);c.own(2,["flashover"])
 Fire.ignite(g,c.action(2,"form"),-1,now)
 check(Fire.count(status)==14 and g.encounter.hp(side)==before_second,"a second owner cannot spend the target's same Flashover interval")
 c.reset();c.equip(1,"fire",["form"]);c.own(1,["wildfire"])
 side=c.scout(Vector3(1,0,-2));var far:=c.scout(Vector3(2.9,0,-2))
 Fire.ignite(g,c.action(1,"form"),-1,now)
 Fire.tick(g,0,now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])==8 and Fire.count(g.encounter.scout(side)[Fire.BURNING])==4,"Wildfire independently copies half the source intensity without consuming it")
 Fire.tick(g,0,now)
 check(not g.encounter.scout(far).has(Fire.BURNING) and Fire.count(g.encounter.scout(side)[Fire.BURNING])==4,"no same-event recursive spread or duplicate periodic grant")
 Fire.tick(g,c.Clock.advance(g,.25),now)
 check(g.encounter.hp(side)==9999,"spread-only Burning deals real secondary damage on the rapid tick cadence")
 c.reset();c.equip(1,"fire");c.own(1,["flashover","wildfire","feeding_the_flames"])
 side=c.scout(Vector3(1,0,-2))
 Fire.ignite(g,c.action(1,"core"),-1,now);Fire.tick(g,0,now)
 check(g.combat_events.any(func(row):return row.shape=="flashover") and g.combat_events.any(func(row):return row.shape=="wildfire"),"Flashover and Wildfire are independent and work together")
 c.reset()
 for peer in [1,2,3,4]:
  c.equip(peer,"fire");c.own(peer,["feeding_the_flames","kindled_roots","kindled_roots","kindled_roots"],3)
  Fire.ignite(g,c.action(peer,"core"),-1,now)
 check(Fire.count(g.tactics.memory[Fire.BURNING])>96 and g.tactics.memory[Fire.BURNING].contributors.size()==4,"four specialized players retain one uncapped shared intensity")
 c.Cards.clear(g.players[1])
 check(not g.players[1].has(Fire.SEQUENCE),"expedition cleanup retires card sequence and speed state")
 c.reset()
 c.equip(1,"thorn",["core"]);c.equip(1,"frost",["form"]);c.equip(1,"fire",["catalyst"])
 var combined: Array=["bloodletting","avalanche","wildfire","sanguine_growth","crystalline_fracture","feeding_the_flames","shatterwave","flashover"]
 c.own(1,combined)
 for id in ["bloodletting","avalanche","wildfire"]:
  check(c.Cards.Ledger.requirement(c.Catalog.DEFINITIONS[id],g.combat_build(g.players[1]).affinity_build()).is_empty(),"mixed locked loadout supports "+id+" without a universal Core requirement")
 side=c.scout(Vector3(1,0,-2))
 var thorn=load("res://thorn_affinity.gd")
 thorn.patch(g,c.action(1,"core"),g.tactics.position,1.0,now)
 var active=load("res://card_active_actions.gd")
 active.command(g,1,g.players[1],active.request(g,g.players[1],"bloodletting",Vector2(0,-1),1000))
 Frost.apply(g,c.action(1,"form"),-1,3,now)
 Fire.ignite(g,c.action(1,"catalyst"),-1,now);Fire.tick(g,0,now)
 check(g.combat_events.any(func(row):return row.shape=="bloodletting") and g.combat_events.any(func(row):return row.shape=="wildfire") and Frost.state(g.encounter.scout(side),now).get("stacks",[]).size()==1,"all three transformations coexist with supporting cards on one legitimate eight-card loadout")
 check(g.tactics.memory.has(thorn.BLEED) and g.encounter.scout(side).has(Fire.BURNING),"different shared affinity statuses do not overwrite each other")
 var ready:=Fire.effect_ready(g,-1,Fire.FLASH_READY)
 c.Expedition.set_world(g,{"combat_epoch":g.participation.epoch()+1})
 check(ready>0 and Fire.effect_ready(g,-1,Fire.FLASH_READY)==0,"target effect reservations cannot leak into a different world identity")
 g.queue_free();await process_frame
 if not failed:print("PASS: CE02 Fire ",checks," application, retention, tempo, actual spending, independent spread and four-owner scaling checks")
 quit(int(failed))
