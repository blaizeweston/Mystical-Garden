extends SceneTree
const Effects = preload("res://enemy_affinity_effects.gd")
const Case=preload("res://tests/support/affinity_card_case.gd")
const Water=preload("res://water_combat.gd")
const Tides=preload("res://water_tidal_return.gd")
const Vitals=preload("res://player_vitals.gd")
const Conditions=preload("res://player_hit_conditions.gd")
const Protection=preload("res://player_protection.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE03 Water: ",label)
func reset():
 c.reset();c.game.effect_timeline.clear_native()
 for p in c.game.players.values():
  p.erase(Water.SEQUENCE);p.erase(Water.REFRESH)
  p[Vitals.STATE]=Vitals.Health.new(70,100)
  p[Protection.STATE]=p[Protection.STATE].clear_expedition()
func drain(start: int):
 var records: Array=c.game.effect_timeline.native_records().filter(func(row):return row.kind=="water_tide")
 if records.is_empty():return
 start=int(records[0].waves[0].start)
 for offset in [0,225,451,675,901,1100,1350,1575,1790,1950]:c.game.effect_timeline.advance_native(c.game.native_effects_world,start+offset)
func run():
 c.create(self)
 var g: Node=c.game
 var now:=preload("res://combat_clock.gd").now()
 reset();c.equip(1,"water",["form"])
 var event:=c.action(1,"form")
 for index in 7:Water.drench(g,event,-1)
 var status: Dictionary=Effects.read(g,-1)[Water.DRENCHED]
 check(status.saturation==5 and g.effect_timeline.native_count()==1 and g.enemy_health()==1000000,"105 pressure admits one delayed event and retains five overflow")
 var tide: Dictionary=g.effect_timeline.native_records()[0]
 check(tide.waves.size()==1 and tide.waves[0].origin==g.players[1].pos and tide.waves[0].damage==6 and tide.waves[0].heal==6,"solo Form alone owns a full six-damage six-healing directional Surge")
 g.players[1][Conditions.STATE]=g.players[1][Conditions.STATE].with_slow_until(now+5000)
 drain(now)
 check(g.enemy_health()==999994 and g.players[1][Vitals.STATE].hp()==76 and g.players[1][Conditions.STATE].slow_until_ms()==0,"outgoing damage and returning restoration/cleanse resolve once")
 check(g.combat_events.any(func(e):return e.shape=="heal" and e.get("form","")=="water_heal" and e.combo==1 and e.amount==6),"returning tide displays only its actual applied restoration")
 var hp: float=g.players[1][Vitals.STATE].hp()
 drain(now)
 check(g.enemy_health()==999994 and g.players[1][Vitals.STATE].hp()==hp and status.saturation==5,"repeated timeline execution neither repeats contacts nor generates pressure")
 reset();c.equip(1,"water",["form"])
 var interval: float=int(g.combat_build(g.players[1]).basic_stats().interval)/1000.0
 for index in 7:
  Water.drench(g,c.action(1,"form"),-1)
  if index<6:Water.tick(g,c.Clock.advance(g,interval))
 check(Effects.read(g,-1)[Water.DRENCHED].saturation==5 and g.effect_timeline.native_count()==1,"ordinary Form-only attacks at the actual weapon interval reach Surge without hidden pressure decay")
 drain(now)
 check(g.enemy_health()==999994 and g.players[1][Vitals.STATE].hp()==76,"paced solo Form applications provide real offensive and restorative baseline value")
 Water.tick(g,c.Clock.advance(g,(Water.DURATION_MS+1)/1000.0))
 check(not Effects.read(g,-1).has(Water.DRENCHED),"idle Drenched expiration retires the remaining pressure and contributor records")
 reset()
 for peer in [1,2,3,4]:
  c.equip(peer,"water",["catalyst"])
  Water.drench(g,c.action(peer,"catalyst"),-1)
 tide=g.effect_timeline.native_records()[0]
 var damage:=0;var healing:=0;var weight:=0
 for wave in tide.waves:damage+=int(wave.damage);healing+=int(wave.heal);weight+=int(wave.weight)
 check(tide.waves.size()==4 and damage==6 and healing==6 and weight==100 and Effects.read(g,-1)[Water.DRENCHED].saturation==20,"four contributors share one threshold and total potency, with deterministic rounding")
 drain(now)
 check(g.enemy_health()==999994 and g.players[1][Vitals.STATE].hp()==76,"four overlapping returning shares total six healing rather than four full Surges")
 reset();c.equip(1,"water");c.own(1,["gathering_clouds","widening_curtain","restorative_rain","crushing_surf","restorative_surge","wide_wake","breakwater","focused_current","undertow"])
 event=c.action(1,"core")
 check(event.potency().saturation_bonus==8 and g.combat_build(g.players[1]).core_skill().radius>Water.WAVE_RADIUS,"Core pressure and real curtain width are resolved")
 event.publish(g,"core_action","touch","1",now,{"player":1})
 event.publish(g,"core_action","touch","1",now,{"player":1})
 check(g.players[1][Vitals.STATE].hp()==74,"Dewfall baseline plus Restoration restores four HP only once")
 for index in 3:Water.drench(g,event,-1)
 tide=g.effect_timeline.native_records()[0]
 check(tide.waves[0].damage==8 and tide.waves[0].heal==8 and tide.waves[0].width>.7 and tide.waves[0].push>.2,"independent potency, healing, coverage and push cards all reach execution")
 drain(now)
 check(g.enemy_health()==999990 and g.players[1][Protection.STATE].charge_count()==1,"Focused Current improves the triggering victim; Breakwater grants a real native Ward")
 reset();c.equip(1,"water",["form"]);c.own(1,["saturating_strikes","rolling_current","pressure_point","refreshing_strikes"])
 for index in 3:
  event=c.action(1,"form");event.publish(g,"weapon_contact",str(index),"leader",now,{"enemy":-1})
 check(Effects.read(g,-1)[Water.DRENCHED].saturation==60,"successive attacks apply 18, 20 and 22 actual pressure")
 check(Water.ordinary_bonus(g,event,-1)==2 and Water.ordinary_bonus(g,event,-1)==0,"Pressure Point adds damage to one primary target only")
 check(g.players[1].has(Water.REFRESH),"eligible basic hits prepare attributed healing")
 for index in 2:c.action(1,"form").publish(g,"weapon_contact",str(index+3),"leader",now,{"enemy":-1})
 check(not g.players[1].has(Water.REFRESH) and g.effect_timeline.native_records()[0].waves[0].heal==7,"the accepted threshold spends one healing preparation in that owner's weighted share")
 reset();c.equip(1,"water");c.own(1,["tidal_resonance","cleansing_response"])
 g.players[1].frame=0
 var tree=g.Classes.connected_tree(0);g.players[1].character[tree.profile_key]=tree.state([tree.nodes[0].id])
 event=c.action(1,"catalyst")
 Water.drench(g,event,-1)
 check(Effects.read(g,-1)[Water.DRENCHED].saturation==36,"class response pressure gets its separate contribution")
 g.players[2].pos=Vector3(2.55,0,0);g.players[2][Conditions.STATE]=g.players[2][Conditions.STATE].with_slow_until(now+4000)
 Water.wash(g,event,Vector3.ZERO)
 check(g.players[2][Conditions.STATE].slow_until_ms()==0,"Cleansing Response expands actual support footprint without a separate heal")
 reset();c.equip(1,"water",["form"]);c.own(1,["monsoon"])
 for index in 7:Water.drench(g,c.action(1,"form"),-1)
 tide=g.effect_timeline.native_records()[0]
 check(tide.waves.size()==3 and not tide.waves[0].ring and tide.waves[1].ring,"Monsoon keeps the normal directional wave and adds two independent rings")
 drain(now)
 check(g.enemy_health()==999990 and g.players[1][Vitals.STATE].hp()==80 and g.effect_timeline.native_count()==0,"Monsoon produces finite damage/restoration without pressure or recursive waves")
 reset()
 for peer in [1,2,3,4]:
  c.equip(peer,"water",["catalyst"]);c.own(peer,["monsoon"])
  Water.drench(g,c.action(peer,"catalyst"),-1)
 tide=g.effect_timeline.native_records()[0]
 damage=0;healing=0
 for wave in tide.waves:damage+=int(wave.damage);healing+=int(wave.heal)
 check(tide.waves.size()==12 and damage==10 and healing==10,"four Monsoon owners round weighted ring groups once, preserving ten total potency instead of multiplying full Surges")
 reset();c.equip(1,"water",["form"])
 for index in 7:Water.drench(g,c.action(1,"form"),-1)
 g.players[1][preload("res://player_lifecycle.gd").STATE]=preload("res://player_lifecycle.gd").start_life()
 drain(now)
 check(g.enemy_health()==1000000,"previous-life contributor waves cannot execute")
 reset();c.equip(1,"water",["form"]);c.own(1,["refreshing_strikes"])
 for index in g.effect_timeline.NATIVE_LIMIT:g.effect_timeline.schedule_native({"kind":"fixture","owner":1,"epoch":g.participation.epoch(),"life":preload("res://player_lifecycle.gd").generation(g.players[1]),"until":now+99999,"next":now+99999})
 for index in 7:c.action(1,"form").publish(g,"weapon_contact",str(index),"leader",now,{"enemy":-1})
 check(Effects.read(g,-1)[Water.DRENCHED].saturation==105 and g.players[1].has(Water.REFRESH),"capacity refusal preserves earned pressure and healing preparation")
 var frame: Dictionary=g.effect_timeline.savepoint();g.effect_timeline.clear_native();g.effect_timeline.restore_savepoint(frame)
 check(g.effect_timeline.native_count()==g.effect_timeline.NATIVE_LIMIT,"existing effect rollback restores the authoritative queue")
 reset();c.equip(1,"water",["form"])
 var terrain=load("res://tests/support/terrain_case.gd")
 terrain.add_wall(g.battlefield,Rect2(-1,-1.3,2,.3))
 for index in 7:Water.drench(g,c.action(1,"form"),-1)
 drain(now)
 check(g.enemy_health()==1000000,"substantial solid cover stops outgoing tide contact")
 terrain.walls(g.battlefield,[])
 reset();c.equip(1,"water",["form"])
 var water_shape=terrain.Shape.shape("water_test","water",terrain.rectangle(-1,-1.4,1,-.8))
 terrain.area(g.battlefield,terrain.rectangle(-29,-28,30,29),[],[water_shape])
 for index in 7:Water.drench(g,c.action(1,"form"),-1)
 drain(now)
 check(g.enemy_health()==999994,"TC01 projectile clearance allows an outgoing tide over unsupported open water")
 terrain.walls(g.battlefield,[])
 reset();c.equip(1,"water",["core"]);c.equip(2,"water",["catalyst"])
 Water.drench(g,c.action(1,"core"),-1)
 for index in 2:Water.drench(g,c.action(2,"catalyst"),-1)
 var lifecycle=load("res://player_lifecycle.gd")
 var original_life: RefCounted=g.players[2][lifecycle.STATE]
 g.players[2][lifecycle.STATE]=original_life.fall()
 drain(now)
 check(g.enemy_health()==999998 and g.players[1][Vitals.STATE].hp()==72,"fallen contributor's four-point share is cancelled, never transferred to the remaining owner")
 g.players[2][lifecycle.STATE]=original_life
 reset();c.equip(2,"water",["form"])
 for index in 7:Water.drench(g,c.action(2,"form"),-1)
 g.network_session.release_peer(2)
 drain(now)
 check(g.enemy_health()==1000000,"disconnected contributors cannot execute pending waves")
 reset();c.equip(1,"water",["form"])
 for index in 7:Water.drench(g,c.action(1,"form"),-1)
 c.Expedition.set_world(g,{"combat_epoch":g.participation.epoch()+1})
 drain(now)
 check(g.enemy_health()==1000000 and g.effect_timeline.native_count()==0,"floor identity changes retire pending waves")
 g.queue_free();await process_frame
 if not failed:print("PASS: CE03 Water ",checks," weighted tide, application, healing, Monsoon, duplicate and stale-source checks")
 quit(int(failed))
