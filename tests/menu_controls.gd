extends SceneTree
const Settings=preload("res://app_settings.gd")
var failed=false
func check(ok: bool,message: String):
 if not ok:failed=true;printerr("FAIL menu controls: ",message)
func _initialize():call_deferred("run")
func run():
 var base="res://.godot/menu-controls-"+Crypto.new().generate_random_bytes(8).hex_encode()
 DirAccess.make_dir_recursive_absolute(base)
 var model=Settings.new();model.path=base+"/settings.cfg";check(model.load_settings()==ERR_FILE_NOT_FOUND,"first launch has no saved settings");model.apply()
 for bus in ["Master","SFX","Music","Ambience"]:
  check(is_equal_approx(AudioServer.get_bus_volume_db(AudioServer.get_bus_index(bus)),linear_to_db(.5)),"first launch applies 50% to "+bus)
 var window=load("res://settings_panel.gd").new();root.add_child(window);window.begin(model)
 var pages: TabContainer=window.find_child("SettingsCategories",true,false)
 check(pages!=null and pages.get_tab_count()==5 and pages.get_tab_title(0)=="Gameplay" and pages.get_tab_title(3)=="Controls","settings groups gameplay, display, audio, controls and diagnostics")
 pages.current_tab=3
 check(window.binding_buttons.attack[0].is_visible_in_tree(),"controls tab exposes key bindings")
 window.capture_binding("attack",0)
 check(not window.assign_binding({"kind":"key","code":KEY_W}),"duplicate controls rejected")
 check(window.assign_binding({"kind":"key","code":KEY_J}),"new binding accepted")
 window.cancel();check(Settings.hint("attack")=="Space" and not FileAccess.file_exists(model.path),"cancel does not change controls or write settings")
 window.begin(model);window.capture_binding("attack",0);window.assign_binding({"kind":"key","code":KEY_J});window.master.value=37;window.effects.value=100;window.music.value=21;window.ambience.value=0;window.indicator.button_pressed=false;window.save()
 var saved=Settings.new();saved.path=model.path;check(saved.load_settings()==OK and saved.values.master==.37 and saved.values.effects==1.0 and saved.values.music==.21 and saved.values.ambience==0.0 and not saved.values.aim_indicator,"saved audio levels and gameplay preferences persist")
 check(Settings.hint("attack")=="J" and InputMap.action_get_events("attack")[1] is InputEventMouseButton,"key and alternate mouse binding applied")
 window.begin(saved)
 var restore: Button=window.find_child("SettingsActions",true,false).get_child(0)
 restore.pressed.emit()
 check([window.master.value,window.effects.value,window.music.value,window.ambience.value]==[50.0,50.0,50.0,50.0],"Restore Defaults sets all audio sliders to 50%")
 window.cancel()
 var invalid=Settings.normalize({"master":-9,"effects":NAN,"fps":7,"bindings":{"attack":[{"kind":"key","code":KEY_ESCAPE}],"session_menu":[]}})
 check(invalid.master==0 and invalid.effects==.5 and invalid.fps==120 and invalid.bindings.session_menu.size()==1 and invalid.bindings.attack.is_empty(),"invalid configuration clamped and Escape retained")
 var old_core=Settings.normalize({"bindings":{"attack":[{"kind":"key","code":KEY_B}]}})
 check(old_core.bindings.core_skill==[{"kind":"key","code":KEY_X}] and old_core.bindings.card_active_two.is_empty(),"new card defaults cannot displace migrated Core control")
 var customized_cards=Settings.normalize({"bindings":{"attack":[{"kind":"key","code":KEY_B}],"card_active_two":[{"kind":"key","code":KEY_X}]}})
 check(customized_cards.bindings.core_skill==[{"kind":"key","code":KEY_Z}] and customized_cards.bindings.card_active_one.is_empty(),"explicit card controls retain priority during Core migration")
 var fresh=Settings.normalize({})
 check(fresh.bindings.core_skill==[{"kind":"key","code":KEY_B}] and fresh.bindings.card_active_one==[{"kind":"key","code":KEY_Z}] and fresh.bindings.card_active_two==[{"kind":"key","code":KEY_X}],"fresh controls retain B, Z and X defaults")
 var legacy_summary=Settings.normalize({"bindings":{"floor_map":[{"kind":"key","code":KEY_TAB}]}})
 check(legacy_summary.bindings.run_summary.is_empty() and legacy_summary.bindings.floor_map[0].code==KEY_TAB,"legacy Tab bindings are preserved")
 check(Settings.defaults().bindings.run_summary[0].code==KEY_TAB,"Tab opens the expedition summary by default")
 var changed=model.values.duplicate(true);changed.bindings.class_skill=[{"kind":"key","code":KEY_C}];changed.bindings.floor_map=[{"kind":"key","code":KEY_K}];model.values=Settings.normalize(changed);model.apply()
 check(InputMap.action_get_events("craft").is_empty() and Settings.hint("floor_map")=="K","remapping overrides old shortcuts and includes map")
 var chart=load("res://exploration.gd").new();root.add_child(chart);var key=InputEventKey.new();key.physical_keycode=KEY_K;key.pressed=true;chart._unhandled_key_input(key);check(chart.expanded,"custom map key works");chart.free()
 window.free()
 var worlds=load("res://save_slots.gd").new();worlds.root_path=base+"/worlds";worlds.prepare(false);worlds.new_world(0)
 var roster=load("res://character_slots.gd").new();roster.root_path=worlds.root_path+"/characters";roster.prepare(worlds);roster.create(0,"Rowan",0,[])
 var identity=roster.summary(0).identity;var garden=FileAccess.get_file_as_bytes(worlds.paths(0).garden);var digest=FileAccess.get_sha256(roster.paths(0).character)
 check(roster.delete_character(0)==ERR_UNAUTHORIZED,"deletion requires confirmation")
 roster.claim(0);check(roster.delete_character(0,true,digest)==ERR_BUSY,"active character protected");roster.release(0)
 check(roster.delete_character(0,true,"changed")==ERR_BUSY,"changed profile protected")
 check(roster.delete_character(0,true,digest)==OK and not roster.summary(0).exists,"confirmed deletion frees slot")
 var catalog=ConfigFile.new();catalog.load(roster.root_path+"/catalog.cfg");var archive=catalog.get_value("deleted_identities",identity,"")
 check(FileAccess.file_exists(archive+"/character.cfg") and FileAccess.get_file_as_bytes(worlds.paths(0).garden)==garden,"recovery copy exists and Garden untouched")
 roster.prepare(worlds);check(not roster.summary(0).exists,"deleted profile not recreated on refresh")
 check(roster.create(0,"New Rowan",1,[])==OK and roster.summary(0).identity!=identity,"slot reusable with new identity")
 var menu=load("res://main_menu.tscn").instantiate();menu.storage=worlds;menu.settings_path=model.path;menu.import_legacy=false;menu.restore_last_selection=false;root.add_child(menu)
 menu.select_character(0);menu.request_delete_character();check(menu.character_deletion.visible,"main menu confirmation displayed");menu.character_deletion.hide();check(roster.summary(0).exists,"closing dialog preserves character")
 menu.free();Settings.new().apply()
 if not failed:print("PASS: character deletion recovery, active and changed-profile safeguards, slot reuse, settings persistence, conflict handling and cancel")
 quit(1 if failed else 0)
