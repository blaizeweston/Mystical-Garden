extends SceneTree
const Slots=preload("res://save_slots.gd")
var failed:=false
func check(ok: bool,message: String):
 if not ok: failed=true;printerr("FAIL delete save: ",message)
func _initialize(): call_deferred("run")
func run():
 var base: String="res://.godot/delete_test_"+Crypto.new().generate_random_bytes(8).hex_encode()
 var slots:=Slots.new();slots.root_path=base.path_join("slots")
 slots.legacy_garden=base.path_join("legacy_garden.cfg");slots.legacy_character=base.path_join("legacy_character.cfg");slots.legacy_guest=base.path_join("legacy_guest.cfg")
 slots.prepare(false)
 for i in 3: slots.new_game(i)
 var first_garden:=FileAccess.get_file_as_bytes(slots.paths(0).garden)
 var first_character:=FileAccess.get_file_as_bytes(slots.paths(0).character)
 var other:=FileAccess.get_file_as_bytes(slots.paths(2).garden)
 check(slots.delete_save(-1,true)==ERR_INVALID_PARAMETER and slots.delete_save(3,true)==ERR_INVALID_PARAMETER,"invalid slot IDs cannot affect other paths")
 check(slots.delete_save(0)==ERR_UNAUTHORIZED and slots.summary(0).exists,"storage requires explicit confirmation")
 var menu=load("res://main_menu.tscn").instantiate()
 menu.storage=slots;menu.import_legacy=false;menu.restore_last_selection=false
 root.add_child(menu)
 menu.request_delete_save()
 check(menu.deletion_confirmation.visible and menu.deletion_confirmation.dialog_text.contains("Slot 1") and slots.summary(0).exists,"Delete opens named confirmation before touching files")
 menu.deletion_confirmation.canceled.emit();menu.deletion_confirmation.hide()
 check(menu.pending_delete==-1 and slots.summary(0).exists,"cancel preserves Garden and character")
 menu.request_delete_save()
 menu.select_slot(2)
 menu.confirm_delete_save();menu.deletion_confirmation.hide()
 check(not slots.summary(0).exists and menu.characters.summary(0).exists and FileAccess.get_file_as_bytes(slots.paths(2).garden)==other,"confirmation targets original slot and leaves other saves intact")
 var marker:=ConfigFile.new();marker.load(slots.paths(0).directory.path_join("deleted.cfg"))
 var archive: String=marker.get_value("deletion","archive","")
 check(FileAccess.get_file_as_bytes(archive.path_join("garden.cfg"))==first_garden and FileAccess.get_file_as_bytes(menu.characters.paths(0).character).size()>0,"deletion preserves complete recovery copies")
 DirAccess.copy_absolute(archive.path_join("garden.cfg"),slots.legacy_garden)
 DirAccess.copy_absolute(slots.paths(0).character,slots.legacy_guest)
 slots.prepare(true)
 check(not slots.summary(0).exists,"legacy import cannot resurrect explicitly deleted Garden")
 menu.select_slot(0)
 check(menu.delete_button.disabled and menu.continue_button.disabled,"empty slot disables Delete and Continue")
 check(slots.delete_world(0,true)==ERR_DOES_NOT_EXIST,"empty deletion is harmless")
 menu.select_slot(2);menu.request_delete_save();slots.claim(2)
 menu.confirm_delete_save();menu.deletion_confirmation.hide()
 check(slots.summary(2).exists and menu.delete_button.disabled and menu.notice.text.contains("in use"),"active slot is protected even if it becomes active after confirmation opens")
 slots.release(2)
 # A marker write failure after archiving must restore both live files.
 var before_garden:=FileAccess.get_file_as_bytes(slots.paths(2).garden)
 var before_character:=FileAccess.get_file_as_bytes(slots.paths(2).character)
 DirAccess.make_dir_recursive_absolute(slots.paths(2).directory.path_join("deleted.cfg.tmp"))
 check(slots.delete_save(2,true)!=OK and FileAccess.get_file_as_bytes(slots.paths(2).garden)==before_garden and FileAccess.get_file_as_bytes(slots.paths(2).character)==before_character and not slots.is_active(2),"write failure restores both files and releases lease")
 # Character-only slots can be removed, including their legacy-import eligibility.
 DirAccess.remove_absolute(slots.paths(1).garden)
 menu.select_slot(1)
 check(menu.delete_button.disabled,"world deletion never targets a character-only legacy slot")
 check(slots.delete_save(1,true)==OK,"legacy character-only cleanup remains compatible")
 slots.prepare(true)
 check(not slots.summary(1).character and not slots.summary(1).exists,"deleted guest character is not imported again")
 check(slots.new_world(0)==OK and slots.summary(0).exists,"deleted slot can start a fresh game")
 menu.free()
 if not failed: print("PASS: confirmed save deletion, cancel, captured slot, recovery copies, active-slot race, rollback, character-only slots and legacy import suppression")
 quit(1 if failed else 0)
