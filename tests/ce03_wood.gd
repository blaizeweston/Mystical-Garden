extends SceneTree
const Case=preload("res://tests/support/affinity_card_case.gd")
const Wood=preload("res://wood_affinity.gd")
const Active=preload("res://card_active_actions.gd")
const Sources=preload("res://affinity_status_source.gd")
const Vitals=preload("res://player_vitals.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE03 Wood: ",label)
func reset():
 c.reset()
 for p in c.game.players.values():Wood.clear(p)
func run():
 c.create(self)
 var g: Node=c.game
 var now:=preload("res://combat_clock.gd").now()
 reset();c.equip(1,"wood");c.own(1,["thickened_growth","thickened_growth","reinforced_growth"])
 var event:=c.action(1,"core")
 check(Wood.grant(g,event,1,"core")==42,"two Common Core capacity copies contribute twelve actual protection")
 c.Clock.advance(g,1.0)
 check(Wood.grant(g,c.action(1,"catalyst"),1,"class")==16,"Catalyst capacity is independently improved")
 check(Wood.capacity(Wood.live_grants(g.players[1],1000))==58,"cooperative protection has no former 48-point ceiling")
 check(Wood.capacity(Wood.live_grants(g.players[1],5300))==42,"independent shorter Catalyst grant expires without reducing longer Core capacity")
 reset();c.equip(1,"wood",["form"])
 var build: Dictionary=g.combat_build(g.players[1]).affinity_build()
 for id in ["thickened_growth","splinterburst","splinterback"]:
  check(not c.Cards.Ledger.requirement(c.Catalog.DEFINITIONS[id],build).is_empty(),"splinter-only Form cannot supply protection for "+id)
 c.own(1,["concentrated_grain"])
 event=c.action(1,"form")
 event.publish(g,"weapon_contact","primary","leader",now,{"enemy":-1,"point":g.tactics.position,"forward":Vector3.FORWARD})
 check(g.enemy_health()==1000000-event.potency().impact_hp-2,"ordinary offensive Wood upgrade works against one enemy without Splinterburst")
 reset();c.equip(1,"wood",["form"]);c.own(1,["splinter_volley","hardwood_tips"])
 var first:=c.scout(Vector3(0,0,-3));var second:=c.scout(Vector3(0,0,-4));var third:=c.scout(Vector3(.9,0,-3))
 event=c.action(1,"form")
 event.publish(g,"weapon_contact","primary","leader",now,{"enemy":-1,"point":g.tactics.position,"forward":Vector3.FORWARD})
 check(g.encounter.hp(first)==9995 and g.encounter.hp(second)==9995 and g.encounter.hp(third)==9995,"extra fragment targets and true lane penetration both deal real damage")
 check(g.enemy_health()==1000000-event.potency().impact_hp,"fragments do not repeat the initiating primary contact")
 var before: int=g.encounter.hp(second)
 event.publish(g,"weapon_contact","primary","leader",now,{"enemy":-1})
 check(g.encounter.hp(second)==before,"duplicate contact cannot emit a second volley")
 reset();c.equip(1,"wood");c.own(1,["bursting_canopy","heartwood_pressure"])
 event=c.action(1,"core")
 event.publish(g,"core_action","activate","",now,{"center":Vector3.ZERO})
 check(Wood.capacity(Wood.live_grants(g.players[1],0))==30 and g.enemy_health()==999993,"Core activation fragments gain five percent of thirty actual held Bark")
 reset();c.equip(1,"wood",["catalyst"]);c.own(1,["shattering_canopy","reinforced_growth"])
 event=c.action(1,"catalyst")
 event.publish(g,"class_action","cast","",now,{"response":"self_bark","enemies":[-1],"center":g.tactics.position})
 check(Wood.capacity(Wood.live_grants(g.players[1],0))==16 and g.enemy_health()==999995,"class offense admits improved Bark and one real secondary splinter")
 reset();c.equip(1,"wood");c.own(1,["splinterguard","splinterback"])
 Wood.grant(g,c.action(1,"core"),1,"core")
 first=c.scout(Vector3(1,0,-1))
 var plan:=Wood.absorption_plan(g.players[1],10,0)
 Wood.consume(g.players[1],plan)
 g.tactics.resolve_attack_from(-1,Wood.after_hit.bind(g,1,g.participation.epoch(),plan,now))
 check(g.enemy_health()==999995 and g.encounter.hp(first)==9995,"separately learned guard and retaliation fragments coexist after real absorption")
 var hp: int=g.enemy_health()
 g.tactics.resolve_attack_from(-1,Wood.after_hit.bind(g,1,g.participation.epoch(),plan,now))
 check(g.enemy_health()==hp,"source/recipient interval prevents replayed retaliation")
 reset();c.equip(1,"wood");c.own(1,["splinterburst","thickened_growth","thickened_growth","thickened_growth","thickened_growth"],3)
 Wood.grant(g,c.action(1,"core"),1,"core")
 var held:=Wood.capacity(Wood.live_grants(g.players[1],0))
 var health: float=g.players[1][Vitals.STATE].hp()
 var command:=Active.request(g,g.players[1],"splinterburst",Vector2.UP,100)
 Active.command(g,1,g.players[1],command)
 check(held==90 and g.enemy_health()==1000000-held and Wood.capacity(Wood.live_grants(g.players[1],0))==0,"Splinterburst spends ninety actual Bark once for ninety radial damage")
 check(g.players[1][Vitals.STATE].hp()==health and not g.players[1].has(Wood.RETALIATION),"resource expenditure is not incoming damage or retaliation")
 Active.command(g,1,g.players[1],command)
 check(g.enemy_health()==1000000-held and Active.owner_state(g,g.players[1])[0].remaining>0,"duplicate activation neither spends nor damages twice and publishes cooldown")
 reset();c.equip(1,"wood",["core"]);c.equip(1,"thorn",["form"]);c.own(1,["splinterburst","bloodletting"])
 Wood.grant(g,c.action(1,"core"),1,"core")
 var thorn=load("res://thorn_affinity.gd");thorn.patch(g,c.action(1,"form"),g.tactics.position,1.0,now)
 check(Active.actions(g.players[1]).size()==2,"two separately acquired active transformations coexist with B/Q/R")
 command=Active.request(g,g.players[1],"splinterburst",Vector2.UP,200)
 c.Expedition.set_world(g,{"combat_epoch":g.participation.epoch()+1})
 Active.command(g,1,g.players[1],command)
 check(Wood.capacity(Wood.live_grants(g.players[1],0))==30,"a stale-world active request cannot spend Bark")
 g.queue_free();await process_frame
 if not failed:print("PASS: CE03 Wood ",checks," grants, splinters, penetration, retaliation and exact resource-action checks")
 quit(int(failed))
