extends SceneTree
const Case=preload("res://tests/support/affinity_card_case.gd")
const Frost=preload("res://frost_combat.gd")
const Events=preload("res://combat_action_events.gd")
const Hits=preload("res://outgoing_hits.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE02 Frost: ",label)
func run():
 c.create(self)
 var g: Node=c.game
 var now:=preload("res://combat_clock.gd").now()
 c.equip(1,"frost")
 c.own(1,["fractured_bloom","crystalline_fracture","crystalline_fracture","deep_freeze"])
 var e:=c.action(1,"core")
 Frost.apply(g,e,-1,1,now)
 var status:=Frost.state(g.tactics.memory,now)
 check(status.stacks[0].numerator==21000 and is_equal_approx(float(status.slow),.09),"Core-specific and global copies freeze a 21 HP maximum and stronger first-stack Slow")
 c.equip(2,"frost");var other:=c.action(2,"form")
 Frost.apply(g,other,-1,2,now)
 check(g.enemy_health()==1000000-15,"mixed 21/3 + 12/3 + 12/3 contributions rupture deterministically")
 check(not Frost.rooted(g.tactics.memory,now),"no acquired Rime Lock means no root")
 c.reset();c.equip(1,"frost",["form"])
 c.own(1,["fracturing_edge","relentless_chill"])
 for index in 4:c.action(1,"form").publish(g,"weapon_contact",str(index),"leader",now,{"enemy":-1})
 status=Frost.state(g.tactics.memory,now)
 check(g.enemy_health()==1000000-15 and status.stacks.size()==2,"four quarter credits create a real fifth Form stack at improved potency")
 check(g.players[1][Frost.CREDIT].units==0,"whole stack credit is spent with no hidden overflow")
 c.reset();c.equip(1,"frost",["form"]);c.own(1,["cold_precision"])
 Frost.apply(g,c.action(1,"form"),-1,2,now)
 var hit:={"damage":0.0,"affinity_hp":8,"knockback":-.35,Events.CONTEXT:c.action(1,"form")}
 var outcome:=Hits.hit_world(g,1,-1,Vector3.ZERO,hit,now)
 check(outcome.applied_hp==10,"Cold Precision adds native damage for the two pre-hit shared stacks")
 c.reset();c.equip(1,"frost",["catalyst"])
 c.own(1,["winters_judgment","spreading_chill","shatter_rhythm"])
 var side:=c.scout(Vector3(1,0,-2))
 e=c.action(1,"catalyst");e.native_slot=1
 Frost.apply(g,e,-1,3,now)
 check(g.enemy_health()==1000000-15,"Winter judgment improves only Catalyst contributions")
 var neighbor:=Frost.state(g.encounter.scout(side),now)
 check(neighbor.stacks.size()==1 and neighbor.stacks[0].numerator==1500,"Spreading Chill adds one reduced attributed stack")
 Frost.apply(g,e,-1,1,now)
 check(Frost.state(g.encounter.scout(side),now).stacks.size()==1,"one class action cannot duplicate its side spread")
 check(g.players[1][Frost.RHYTHM].has(1),"actual Catalyst rupture prepares the same R slot")
 var next:=c.action(1,"catalyst");next.native_slot=1
 Frost.apply(g,next,-1,1,now)
 check(next.card_potency_bonus==2,"next action captures earned rhythm without changing baseline potency")
 c.reset();c.equip(1,"frost",["core"])
 c.own(1,["returning_winter"])
 e=c.action(1,"core")
 var cast:={"center":g.tactics.position,"owner":1,"affinity_action":e}
 Frost.bloom_phase(g,cast,"open",2,now)
 Frost.bloom_phase(g,cast,"close",1,now)
 check(Frost.state(g.tactics.memory,now).stacks.size()==1,"Returning Winter independently adds a closing stack")
 var before:int=g.enemy_health()
 Frost.bloom_phase(g,cast,"close",1,now)
 check(g.enemy_health()==before and Frost.state(g.tactics.memory,now).stacks.size()==1,"duplicate closing publication creates no additional stack")
 c.reset();c.equip(1,"frost",["form"])
 c.own(1,["rime_lock","shatterwave","avalanche"])
 side=c.scout(Vector3(1,0,-2))
 var far:=c.scout(Vector3(1.5,0,-2))
 e=c.action(1,"form")
 Frost.apply(g,e,side,2,now)
 var starting:int=g.enemy_health()
 Frost.apply(g,e,-1,3,now)
 check(g.enemy_health()==starting-16,"native rupture and independent Shatterwave coexist")
 check(Frost.rooted(g.tactics.memory,now) and not Frost.rooted(g.tactics.memory,now+151),"Rime Lock adds only its acquired brief root")
 check(g.encounter.hp(side)==10000-2-12-2,"Avalanche may complete a nearby rupture with its independently acquired Shatterwave")
 check(Frost.rooted(g.encounter.scout(side),now),"a propagated rupture retains its acquired Rime Lock without recursive propagation")
 check(Frost.state(g.encounter.scout(far),now).stacks.size()==1,"Avalanche cannot recursively spread through its own secondary rupture")
 Frost.apply(g,c.action(1,"form"),far,2,now)
 check(Frost.state(g.tactics.memory,now).stacks.size()==1,"a subsequent legitimate attack can trigger another Avalanche")
 c.reset();c.equip(1,"frost");c.own(1,["returning_winter","shatterwave","avalanche"])
 e=c.action(1,"core");side=c.scout(Vector3(1,0,-2))
 cast={"center":g.tactics.position,"owner":1,"affinity_action":e}
 Frost.bloom_phase(g,cast,"open",2,now);Frost.bloom_phase(g,cast,"close",1,now)
 check(g.combat_events.any(func(row):return row.shape=="shatterwave"),"all three independent Frost cards function together")
 g.queue_free();await process_frame
 if not failed:print("PASS: CE02 Frost ",checks," weighted stacks, all thirteen cards, independent roots/waves/propagation and recursion checks")
 quit(int(failed))
