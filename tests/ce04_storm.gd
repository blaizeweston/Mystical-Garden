extends SceneTree
const Case=preload("res://tests/support/affinity_card_case.gd")
const Storm=preload("res://storm_affinity.gd")
const Sources=preload("res://affinity_status_source.gd")
const Timing=preload("res://basic_attack_timing.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE04 Storm: ",label)
func reset():
 c.reset()
 c.game.combat_events.clear()
 for p in c.game.players.values():Storm.clear(p)
func cast(slot: String="core") -> RefCounted:
 var event:=c.action(1,slot)
 event.publish(c.game,"core_action" if slot=="core" else "weapon_contact","test","leader",preload("res://combat_clock.gd").now(),{"enemy":-1,"origin":Vector3.ZERO,"point":c.game.tactics.position})
 return event
func run():
 c.create(self)
 var g: Node=c.game
 var now:=preload("res://combat_clock.gd").now()
 reset();c.equip(1,"storm",["core"]);c.own(1,["extended_circuit","long_arc"])
 var victims:=[]
 for index in 5:victims.append(c.scout(Vector3(0,0,-3.2-index*1.2)))
 cast()
 check(g.enemy_health()==999978 and g.encounter.hp(victims[0])==9985 and g.encounter.hp(victims[1])==9989 and g.encounter.hp(victims[2])==9992 and g.encounter.hp(victims[3])==10000,"extra chain target uses native falloff and unique ordered contacts")
 check(c.action(1,"core").potency().jump_range_cm==25,"Core range contribution reaches captured execution values")
 reset();c.equip(1,"storm",["core"]);c.own(1,["conductor"])
 cast()
 check(g.enemy_health()==999970,"Conductor is useful alone: 22 primary plus one reduced eight-damage return")
 var before: int=g.enemy_health()
 var event:=c.action(1,"core")
 event.publish(g,"core_action","one","leader",now,{"enemy":-1,"origin":Vector3.ZERO,"point":g.tactics.position})
 event.publish(g,"core_action","one","leader",now,{"enemy":-1,"origin":Vector3.ZERO,"point":g.tactics.position})
 check(g.enemy_health()==before-30,"duplicate original event cannot create a second chain/return")
 reset();c.equip(1,"storm",["core"]);c.own(1,["conductor"])
 for point in [Vector3(1,0,-2),Vector3(-1,0,-2),Vector3(0,0,-3),Vector3(1,0,-3)]:c.scout(point)
 cast()
 check(g.combat_events.filter(func(row):return row.shape=="storm_arc").size()==6,"three normal nodes fork into only two remaining unique targets and make one return")
 reset();c.equip(1,"storm",["core"]);c.own(1,["conductor"])
 c.scout(Vector3(0,0,-4.4));c.scout(Vector3(0,0,-6.8))
 cast()
 check(g.enemy_health()==999978,"return strike respects actual jump reach instead of crossing a long chain backwards")
 reset();c.equip(1,"storm",["core"]);c.own(1,["grounded_current"])
 cast()
 check(g.enemy_health()==999971,"unused normal jump potential improves single-target damage without the Unique")
 reset();c.equip(1,"storm",["core"]);c.own(1,["grounded_current","extended_circuit"])
 cast()
 check(g.enemy_health()==999970,"extra chain investment improves the unused-potential conversion against one enemy")
 reset();c.equip(1,"storm",["form"]);c.own(1,["live_wire","ionized_rhythm","conductive_reach"])
 event=cast("form")
 check(g.enemy_health()==999989 and Storm.tempo_percent(g,g.players[1],now+1)==4,"electrical Form damage and actual temporary attack speed both improve")
 var attack: Dictionary=g.weapon_attack_world.capture_attack(1,now+1)
 var base: int=g.combat_build(g.players[1]).basic_stats().interval
 check(attack.interval==Timing.interval(base,4) and attack.interval<base,"actual ordinary launch consumes the same speed calculation as presentation")
 var ui: Dictionary=preload("res://ui/gameplay/player_build_projection.gd").summary(g.run_summary_ui_data(1))
 check(ui.totals.any(func(row):return row[0]=="Attack speed" and row[1]==g.Life.Preview.attack_speed(int(attack.interval))+" attacks/sec"),"Stats uses combined real temporary attack speed")
 check(Storm.tempo_percent(g,g.players[1],int(g.players[1][Storm.TEMPO].until)+1)==0,"electrical tempo expires and never becomes permanent")
 check(event.potency().jump_range_cm==20,"affinity reach works on a functioning Form without requiring Core")
 reset();c.equip(1,"storm");c.own(1,["charged_casting","relay_pulse","spellcharge"])
 var side:=c.scout(Vector3(1,0,-2));var extra:=c.scout(Vector3(2,0,-2))
 event=c.action(1,"catalyst")
 event.publish(g,"class_contact","native","leader",now,{"enemy":-1,"point":g.tactics.position})
 check(g.enemy_health()==999984 and g.encounter.hp(side)==9989 and g.encounter.hp(extra)==9992,"existing offensive Catalyst discharge gains damage and a real extra chain contact")
 check(g.players[1].has(Storm.PREP),"a qualifying class response prepares the next discharge")
 g.encounter.set_hp(side,0);g.encounter.set_hp(extra,0)
 before=g.enemy_health();cast("form")
 check(g.enemy_health()==before-12 and not g.players[1].has(Storm.PREP),"source-owned preparation adds three damage once to the next discharge")
 reset();c.equip(1,"storm",["catalyst"]);c.own(1,["charged_casting","relay_pulse"])
 side=c.scout(Vector3(1,0,-2))
 event=c.action(1,"catalyst")
 Storm.grant(g,event,2)
 c.equip(2,"storm",["form"])
 var recipient:=c.action(2,"form")
 Storm.use_charge(g,recipient,-1,g.tactics.position,now)
 check(g.enemy_health()==999987 and g.encounter.hp(side)==9991,"a granted charge keeps its original provider's improved damage and relay")
 check(not g.players[2].has(Storm.CHARGE),"recipient charge is consumed once")
 reset();c.equip(1,"storm",["core"]);c.own(1,["long_arc","conductive_reach","conductor"])
 event=c.action(1,"core")
 var terrain=load("res://tests/support/terrain_case.gd")
 terrain.add_wall(g.battlefield,Rect2(.3,-3,.4,2))
 side=c.scout(Vector3(1.5,0,-2))
 cast()
 check(g.encounter.hp(side)==10000,"chain reach and forks never bypass solid cover")
 terrain.walls(g.battlefield,[])
 var source:=Sources.capture(event)
 g.players[1][preload("res://player_lifecycle.gd").STATE]=preload("res://player_lifecycle.gd").start_life()
 before=g.enemy_health()
 Storm.discharge(g,1,-1,Vector3.ZERO,g.tactics.position,22,2,now,event.potency(),source)
 check(g.enemy_health()==before,"captured electrical execution rejects a previous-life source")
 g.queue_free();await process_frame
 if not failed:print("PASS: CE04 Storm ",checks," chain, finite fork, solo conversion, tempo and Catalyst checks")
 quit(int(failed))
