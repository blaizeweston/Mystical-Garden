extends SceneTree
const Effects = preload("res://enemy_affinity_effects.gd")
const Case=preload("res://tests/support/affinity_card_case.gd")
const Void=preload("res://void_affinity.gd")
const Core=preload("res://core_combat.gd")
const Active=preload("res://card_active_actions.gd")
const Clock=preload("res://combat_clock.gd")
const Elapsed=preload("res://affinity_time.gd")
const Life=preload("res://player_lifecycle.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE04 Void: ",label)
func reset():
 c.reset();c.game.combat_events.clear();c.game.effect_timeline.clear_native();c.game.effect_timeline.clear_cores()
 Clock.begin_stepped(100000)
 if c.game.has_meta(Void.PENDING):c.game.remove_meta(Void.PENDING)
 for player in c.game.players.values():
  player.erase(Void.FORM_READY);player.erase(Void.PREP);player.core_ready_at=0;player.cast_until=0;player.core_cast_until=0
  player.pos=Vector3.ZERO;player.facing=Vector3.FORWARD
 for key in [Void.CONTROL,Void.SUSTAINED,Void.SHEAR,Void.ALLOWANCE_STATE]:Effects.read(c.game,-1).erase(key)
func advance(ms: int):
 var until:=Clock.now()+ms
 while Clock.now()<until:
  Clock.step();Elapsed.advance(c.game,1.0/60.0)
  c.game.effect_timeline.advance_native(c.game.native_effects_world,Clock.now())
  Core.tick(c.game,Clock.now())
  Void.resolve_motion(c.game,Elapsed.now(c.game),Clock.now())
func field(peer: int,point: Vector3,lifetime:=9000) -> Dictionary:
 var event:=c.action(peer,"core")
 return Void.create_field(c.game,event,point,Clock.now(),lifetime,1080,Void.field_radius(event.potency()),int(event.potency().collapse),float(event.potency().gather_step),float(event.potency().gather_total),false,"test/"+str(event.identity),Clock.now())
func run():
 c.create(self)
 var g: Node=c.game
 var p: Dictionary=g.players[1]
 reset();c.equip(1,"void");c.own(1,["widening_well","deepening_gravity","event_horizon"])
 var resolved=g.combat_build(p)
 check(is_equal_approx(float(resolved.core_skill().radius),3.05) and is_equal_approx(Void.field_radius(c.action(1,"core").potency()),3.05),"Core preview, gathering and collapse share all actual radius contributions")
 var line={"affinity_action":c.action(1,"core"),"center":Vector3(0,0,-2),"grown":false}
 Void.gather(g,line,Clock.now())
 check(line.grown and not g.has_meta(Void.PENDING),"centered target needs no fake displacement to stay valid")
 g.tactics.position=Vector3(0,0,-3.7)
 Void.gather(g,{"affinity_action":c.action(1,"core"),"center":Vector3(0,0,-2),"grown":false},Clock.now())
 check(g.get_meta(Void.PENDING,{}).get(-1,[]).any(func(row):return is_equal_approx(float(row.strength),.216)),"Deepening Gravity improves real native gathering strength")
 reset();c.equip(1,"void",["form"]);c.own(1,["compression_rhythm","condensed_edge"])
 var event:=c.action(1,"form")
 event.publish(g,"weapon_contact","first","leader",Clock.now(),{"enemy":-1})
 check(g.enemy_health()==999990 and int(p[Void.FORM_READY])==1750,"compression interval changes without changing existing baseline damage")
 Void.resolve_motion(g,0,Clock.now())
 var basic:=c.action(1,"form")
 check(Void.ordinary_bonus(g,basic,-1)==2 and Void.ordinary_bonus(g,basic,-1)==0,"successful native Void control improves one first primary contact")
 reset();c.equip(1,"void");c.own(1,["grasping_invocation","dense_casting","dark_echo"])
 event=c.action(1,"catalyst")
 event.publish(g,"class_action","offense","",Clock.now(),{"response":"compression","enemies":[-1],"center":Vector3.ZERO})
 check(g.enemy_health()==999985 and g.get_meta(Void.PENDING,{}).get(-1,[]).any(func(row):return is_equal_approx(float(row.strength),.61)),"existing offensive Catalyst gains three damage and 0.10 m pull")
 check(p.has(Void.PREP),"real class compression prepares Dark Echo")
 var hp: int=g.enemy_health()
 event=c.action(1,"form")
 event.publish(g,"weapon_contact","first","leader",Clock.now(),{"enemy":-1})
 event.publish(g,"weapon_contact","first","leader",Clock.now(),{"enemy":-1})
 check(g.enemy_health()==hp-13 and not p.has(Void.PREP),"Dark Echo adds three once, with no duplicate event damage")
 reset();c.equip(1,"void",["core"]);c.own(1,["rift_shear"])
 field(1,Vector3(-.8,0,-2));field(1,Vector3(.8,0,-2))
 var side:=c.scout(Vector3(-3.3,0,-2))
 Void.resolve_motion(g,0,Clock.now())
 check(g.enemy_health()==999997 and g.encounter.hp(side)==10000,"Rift Shear requires real intersection, not either field alone")
 field(1,Vector3.ZERO);field(1,Vector3(0,0,-3))
 Void.resolve_motion(g,0,Clock.now())
 check(g.enemy_health()==999997,"additional overlapping pairs do not multiply or repeat same-interval shear")
 advance(610)
 check(g.enemy_health()==999994,"one coherent later interval resolves exactly three damage")
 reset();c.equip(1,"void",["core"]);c.own(1,["rift_shear"]);c.equip(2,"void",["core"]);c.own(2,["rift_shear"],3)
 field(1,Vector3(0,0,-2));field(2,Vector3(0,0,-2))
 Void.resolve_motion(g,0,Clock.now())
 check(g.enemy_health()==999991 and g.combat_events.any(func(row):return row.shape=="rift_shear" and row.combo==2),"one strongest eligible contributor supplies deterministic nine-damage attribution")
 reset();c.equip(1,"void",["core"]);c.own(1,["rift_shear"])
 Core.command(g,1,p,Core.request(g,p,Vector2.UP,2.0))
 check(g.effect_timeline.core_records().is_empty() and g.effect_timeline.native_count()==1,"Rift Shear moves its actual Core field directly into existing timeline without competing cast state")
 advance(8000)
 check(g.enemy_health()==999979,"original collapse still occurs once at native potency while gathering lingers")
 Core.command(g,1,p,Core.request(g,p,Vector2.UP,2.0));advance(500)
 check(Void.field_views(g,Elapsed.now(g)).size()==2 and g.enemy_health()<999979,"native cooldown permits genuine solo overlap without owning Singularity")
 check(Core.hints(g).size()==2,"both actual overlapping fields reach normal reliable presentation hints")
 reset();c.equip(1,"void",["form"]);c.own(1,["singularity"])
 var request:=Active.request(g,p,"singularity",Vector2.UP,10,0.0)
 Active.command(g,1,p,request);Active.command(g,1,p,request)
 check(g.effect_timeline.native_count()==1 and g.effect_timeline.native_records()[0].position==Vector3.ZERO,"Singularity supports self-placement for a ranged character and duplicate input admits one field")
 g.tactics.boss_kind=0;var before: Vector3=g.tactics.position
 advance(1600)
 check(g.enemy_health()==999970 and g.tactics.position==before and g.effect_timeline.native_count()==0,"displacement-resistant boss takes full implosion once and field cleans up at final deadline")
 reset();p.frame=0;p.weapon_kind=0
 var tree=g.Classes.connected_tree(0);p.character[tree.profile_key]=tree.state(["vanguard"])
 c.equip(1,"void",["form"]);c.own(1,["singularity"])
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,11,6.0))
 check(g.effect_timeline.native_count()==1 and g.effect_timeline.native_records()[0].position==Vector3(0,0,-6),"melee class may place Singularity at distant legal ground")
 reset();c.equip(1,"void",["core"]);c.own(1,["singularity","rift_shear","crushing_pressure"])
 field(1,Vector3(0,0,-2));advance(700)
 check(Void.sustained_bonus(g,-1,c.action(1,"core").potency())==2,"actual continuous field exposure enables independently acquired pressure damage")
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,12,2.0))
 var projection:=Void.hints(g)
 check(projection.any(func(h):return h.form=="singularity" and h.radius==g.effect_timeline.native_records()[1].radius) and projection.any(func(h):return h.form=="lingering"),"field projections distinguish actual gathering radii and lifetimes")
 check(g.effect_timeline.native_count()==2,"Singularity and ordinary lingering Well coexist independently")
 advance(1700)
 check(g.enemy_health()<999944,"combined genuine overlap and pressure add damage without duplicating whole implosions")
 # Illegal placement and technical capacity refuse without cooldown/resource changes.
 reset();c.equip(1,"void",["core"]);c.own(1,["singularity","rift_shear"])
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,20,8.1))
 check(g.effect_timeline.native_count()==0 and not p.has(Active.STATE),"out-of-range target spends no cooldown")
 for index in g.effect_timeline.NATIVE_LIMIT:field(1,Vector3.ZERO)
 Core.command(g,1,p,Core.request(g,p,Vector2.UP,2.0))
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,21,0.0))
 check(g.effect_timeline.native_count()==g.effect_timeline.NATIVE_LIMIT and p.core_ready_at==0 and not p.has(Active.STATE),"full shared effect capacity explicitly refuses both admissions without cooldown debit")
 reset();c.equip(1,"void",["core"]);c.own(1,["singularity"])
 var old_request:=Active.request(g,p,"singularity",Vector2.UP,22,2.0)
 p[Life.STATE]=Life.start_life()
 Active.command(g,1,p,old_request)
 check(g.effect_timeline.native_count()==0,"previous-life active request fails closed")
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,23,2.0))
 p[Life.STATE]=Life.start_life();advance(1600)
 check(g.effect_timeline.native_count()==0 and g.enemy_health()==1000000,"previous-life field cannot damage after delayed execution")
 # Current runtime owners supply transaction savepoints; no second field ledger.
 reset();c.equip(1,"void",["core"]);c.own(1,["singularity"])
 var saved: Dictionary=g.effect_timeline.savepoint();var prior: Dictionary=p.get(Active.STATE,{}).duplicate(true)
 Active.command(g,1,p,Active.request(g,p,"singularity",Vector2.UP,24,2.0))
 g.effect_timeline.restore_savepoint(saved);p[Active.STATE]=prior;advance(1600)
 check(g.effect_timeline.native_count()==0 and g.enemy_health()==1000000,"owner rollback restores pending action and field without phantom damage")
 reset();p.frame=4;p.weapon_kind=0
 var oracle=g.Classes.connected_tree(4);p.character[oracle.profile_key]=oracle.state(["leykeeper"])
 c.equip(1,"void",["catalyst"])
 var eligible: Array=c.Cards.Ledger.new().eligible(g.combat_build(p).weapon_base_stats(),2200)
 check(not eligible.has("grasping_invocation") and eligible.has("dense_casting"),"native Leykeeper pull keeps priority: suppressed extra pull is ineligible, actual damage remains usable")
 p.character[oracle.profile_key]=oracle.state(["omenreader"])
 eligible=c.Cards.Ledger.new().eligible(g.combat_build(p).weapon_base_stats(),2200)
 check(eligible.has("grasping_invocation"),"a real unopposed offensive Catalyst compression qualifies for pull investment")
 Clock.end_stepped();g.queue_free();await process_frame
 if not failed:print("PASS: CE04 Void ",checks," geometry, real overlap, source, resource and implosion checks")
 quit(int(failed))
