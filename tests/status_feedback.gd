extends SceneTree
const OutgoingHits = preload("res://outgoing_hits.gd")
const HitSession = preload("res://network_session.gd")
const Conditions = preload("res://player_hit_conditions.gd")

const ExpeditionCase = preload("res://tests/support/expedition_case.gd")

const PlayerVitals = preload("res://player_vitals.gd")
const Status=preload("res://combat_status.gd")
const Ranger=preload("res://ranger_combat.gd")
const Frost=preload("res://frost_combat.gd")
const Builds=preload("res://affinity_build.gd")
const Events=preload("res://combat_action_events.gd")
var failed:=false
func check(ok: bool,message: String):
 if not ok:failed=true;printerr("FAIL status feedback: ",message)
func _initialize():
 call_deferred("run")
func run():
 var game=load("res://world.tscn").instantiate();var token:=str(Time.get_ticks_usec())
 game.progress.path="res://.godot/status-"+token;game.local_character.path=game.progress.path+".character";root.add_child(game)
 game.set_process(false);game.set_physics_process(false);game.combat_visuals.set_process(false)
 var p: Dictionary=game.players[1];ExpeditionCase.set_membership(game, p, true);p[PlayerVitals.STATE] = p[PlayerVitals.STATE].with_hp(100);p.pos=Vector3(0,0,-1);p.frame=2
 var tree=game.Classes.connected_tree(2);p.character[tree.profile_key]=tree.state(["wildstalker"])
 game.battlefield.configure(0,1);preload("res://tests/support/terrain_case.gd").walls(game.battlefield,[]);game.encounter.set_hp(-1, 80);game.tactics.position=Vector3(0,0,1);game.enemy_traits.clear();game.encounter.clear_scouts();game.tactics.winding_up=false
 var now:=Time.get_ticks_msec();p[Conditions.STATE] = p[Conditions.STATE].with_slow_until(now+4000)
 var stats: Dictionary={"damage":1.0,"reach":4.0,"knockback":-.35,"ranger_direct_hit":true}
 check(Ranger.track(game,1,p,-1,1,now),"a source-owned Tracked Prey record is accepted")
 Status.sync(game,now)
 check(not Ranger.active_prey(game,game.enemy_traits,now).is_empty(),"the current Tracked Prey lifetime is active")
 var events:=Status.snapshot(game,now);var marks: Array=events.filter(func(e):return e.shape==Ranger.PREY)
 check(marks.size()==1 and events.any(func(e):return e.form=="player" and e.shape=="slow"),"Tracked Prey icon and slowed player callout")
 var mark_id: int=marks[0].id;var count: int=game.combat_event_serial;Status.sync(game,now+1)
 check(game.combat_event_serial==count,"no per-frame event spam")
 game._process(.016);var fx=game.combat_visuals;fx.sync(game.combat_events_snapshot(),[],"status-test",p.pos);fx.statuses.step(.016)
 check(fx.statuses.active.has(mark_id),"renderer creates a persistent Tracked Prey icon")
 var icon: Dictionary=fx.statuses.active[mark_id];game.stage.foe.position.x+=.5;fx.statuses.step(.016)
 check(absf(icon.node.position.x-game.stage.foe.position.x)<.5,"icon follows rendered monster")
 var hp: int=game.enemy_health();OutgoingHits.hit_world(game, HitSession.peer_for(p), -1, p.pos, stats, now+2);Status.sync(game,now+2)
 check(not game.combat_events_snapshot().any(func(e):return e.kind=="status" and e.id==mark_id),"late-join snapshot excludes a consumed Tracked Prey")
 check(not game.enemy_traits.has(Ranger.PREY) and hp-game.enemy_health()==20,"eligible contact consumes Tracked Prey and grants its damage once")
 check(game.combat_events.any(func(e):return e.kind=="proc" and e.shape=="Tracked Prey triggered"),"consumption has its own effect")
 fx.sync(game.combat_events_snapshot(),[],"status-test",p.pos)
 check(not fx.statuses.active.has(mark_id),"consumed icon removed immediately")
 fx.statuses.consume(marks[0]);check(not fx.statuses.active.has(mark_id),"late old snapshot cannot resurrect consumed Tracked Prey")
 check(Ranger.track(game,1,p,-1,2,now+3),"a later cast may grant a fresh Tracked Prey record")
 Status.sync(game,now+3);check(Status.snapshot(game,now+3).any(func(e):return e.shape==Ranger.PREY),"fresh source-owned status is visible")
 game.combat_events.clear();check(Status.snapshot(game,now+4).size()>=2 and game.combat_events_snapshot().any(func(e):return e.kind=="status"),"active statuses survive transient event eviction for late joiners")
 p[Conditions.STATE] = p[Conditions.STATE].cleanse_slow();game.enemy_traits.erase(Ranger.PREY);Status.sync(game,now+5)
 check(not Status.snapshot(game,now+5).any(func(e):return e.shape in [Ranger.PREY,"slow"]),"cleansing and consumption remove live state")
 p[Conditions.STATE] = p[Conditions.STATE].with_slow_until(now+20);Status.sync(game,now+10);Status.sync(game,now+21)
 check(not Status.snapshot(game,now+21).any(func(e):return e.shape=="slow"),"timed expiry clears status independently of text")
 var material: Dictionary=Builds.slot("form",game.Items.get_item("plant_part_plant_frostbell").legacy_part)
 var frost_event: RefCounted=Events.begin(game,1,"form",material,Frost.Balance.QUALITY.ordinary,["weapon_contact"],now+5000)
 Frost.apply(game,frost_event,-1,1,now+22);Status.sync(game,now+22)
 check(Status.snapshot(game,now+22).any(func(e):return e.shape=="brittle"),"a current Frost contribution displays Brittle")
 Frost.apply(game,frost_event,-1,2,now+23);Status.sync(game,now+23)
 check(Frost.state(Frost.body(game,-1),now+23).is_empty() and game.combat_events.any(func(e):return e.kind=="ability" and e.shape=="frost_rupture"),"three current Frost contributions rupture and consume the stacks visibly")
 game.encounter.clear_scouts();game.encounter.register_scout(game.make_scout(0,Vector3(1,0,1),0));game.encounter.set_hp(0, 80);game.encounter.scout(0).pos=Vector3(1,0,1);game.encounter.scout(0).engaged=false;game.trait_events.clear()
 var secondary: Dictionary={"damage":2,"reach":4.0}
 for kind in ["echo","link","chorus"]:
  game.Traits.queue_hit(game,p,0,secondary,now,20,false,game.tactics.position,kind)
  hp=game.encounter.hp(0);game.Traits.tick(game,now+25)
  check(game.encounter.hp(0)<hp and game.combat_events.any(func(e):return e.kind=="proc" and e.shape==kind),"confirmed "+kind+" hit has a matching effect")
 game.combat_events.clear();game.Traits.queue_hit(game,p,0,secondary,now,20,false,game.tactics.position,"echo")
 var replacement: Dictionary=game.make_scout(0,game.encounter.scout(0).pos,0)
 game.encounter.register_scout(replacement, 0);game.Traits.tick(game,now+25)
 check(not game.combat_events.any(func(e):return e.kind=="proc"),"stale delayed attack cannot show a false proc on a new enemy")
 Frost.apply(game,frost_event,0,1,now+30);Status.sync(game,now+30);game.encounter.set_hp(0, 0);Status.sync(game,now+31)
 check(not Status.snapshot(game,now+31).any(func(e):return e.form=="enemy" and e.combo==0),"dead enemy loses status")
 fx.clear();check(fx.statuses.active.is_empty(),"floor cleanup clears status nodes")
 var pending: Dictionary={"kind":"status","shape":"slow","form":"player","id":32000,"combo":99000,"duration":.5,"age":0.0,"height":2.35,"color":"95d7ed"}
 fx.statuses.consume(pending);fx.statuses.step(.1)
 check(fx.statuses.active.has(pending.id) and not fx.statuses.active[pending.id].node.visible,"short status waits for an out-of-order actor snapshot")
 var remote:=Node3D.new();game.stage.add_child(remote);remote.position=game.stage.WILD_OFFSET+p.pos;game.stage.avatars[pending.combo]=remote
 fx.statuses.step(.1)
 check(fx.statuses.active.has(pending.id) and fx.statuses.active[pending.id].node.visible and fx.statuses.active[pending.id].label.text=="Slowed","pending callout attaches when the avatar arrives")
 fx.statuses.step(.4)
 check(not fx.statuses.active.has(pending.id),"waiting for the avatar does not prolong the status")
 game.stage.avatars.erase(pending.combo);remote.queue_free()
 game.queue_free();await process_frame
 if not failed:print("PASS: status transitions, consumed Tracked Preys, brittle, true delayed procs, stale targets, renderer following, eviction, expiry and cleanup")
 quit(1 if failed else 0)
