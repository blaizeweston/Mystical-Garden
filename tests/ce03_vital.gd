extends SceneTree
const Effects = preload("res://enemy_affinity_effects.gd")
const Case=preload("res://tests/support/affinity_card_case.gd")
const Vital=preload("res://vital_combat.gd")
const Vitals=preload("res://player_vitals.gd")
const Lifecycle=preload("res://player_lifecycle.gd")
const Protection=preload("res://player_protection.gd")
const Actions=preload("res://player_weapon_actions.gd")
const Active=preload("res://card_active_actions.gd")
const WeaponCase=preload("res://tests/support/weapon_attack_case.gd")
const Clock=preload("res://combat_clock.gd")
var c:=Case.new()
var failed:=false
var checks:=0
func _initialize():call_deferred("run")
func check(ok: bool,label: String):
 checks+=1
 if not ok:failed=true;printerr("FAIL CE03 Vital: ",label)
func reset():
 c.reset();c.game.weapon_attacks.clear();c.game.effect_timeline.clear_native()
 for p in c.game.players.values():
  Vital.clear(c.game,p)
  p[Vitals.STATE]=Vitals.Health.new(80,100)
  p[Actions.STATE]=p[Actions.STATE].with_ready_at(0)
  p[Protection.STATE]=p[Protection.STATE].clear_expedition()
func shot() -> Dictionary:
 var p: Dictionary=c.game.players[1]
 c.game.weapon_attacks.clear();p[Actions.STATE]=p[Actions.STATE].with_ready_at(0)
 check(WeaponCase.start(c.game,1,p.pos),"ordinary attack is admitted through the real queue")
 return c.game.weapon_attacks.views()[0]
func run():
 c.create(self)
 var g: Node=c.game
 var now:=Clock.now();Clock.begin_stepped(now)
 reset();c.equip(1,"vital")
 c.own(1,["verdant_reserve","deep_renewal","growing_edge","sustaining_strikes","verdant_conduit","living_reserves","persistent_growth","unyielding_growth"])
 var event:=c.action(1,"core")
 var p: Dictionary=g.players[1]
 check(event.potency().bonus_hp==25 and event.potency().regen_per_second==5,"Core, Form and Catalyst investments produce shared personal improvements without grant stacking")
 Vital.grant(g,event,1,0)
 Vital.grant(g,c.action(1,"form"),1,0)
 check(p[Vitals.STATE].max_hp()==125 and p[Vitals.STATE].hp()==80,"two active grants use strongest capacity and never heal on capacity gain")
 var sources: Array=p[Vital.SOURCES].values()
 check(sources.any(func(row):return row.slot=="form" and row.until==3300) and sources.any(func(row):return row.slot=="core" and row.until==5750),"source duration and affinity persistence both reach actual grant expiry")
 c.Clock.advance(g,1);Vital.tick(g,1000)
 check(p[Vitals.STATE].hp()==85,"independent regeneration investments provide five actual HP per second")
 p[Vitals.STATE]=p[Vitals.STATE].refilled()
 c.Clock.advance(g,5);Vital.tick(g,6000)
 check(p[Vitals.STATE].max_hp()==100 and p[Vitals.STATE].hp()==100,"temporary capacity expiry clamps filled bonus HP")
 check(c.Catalog.scope_label(c.Catalog.DEFINITIONS.verdant_reserve)=="Core · Form · Catalyst","cross-slot investment states its actual application scopes")
 reset();c.equip(1,"vital");c.own(1,["blooming_strength","renewed_vigor","flourishing_assault"])
 Vital.grant(g,c.action(1,"core"),1,0)
 Vital.grant(g,c.action(1,"catalyst"),1,0)
 var attack:=shot()
 check(int(attack.stats.vital_primary_bonus_hp)==5,"Bloom strength, short class vigor and modest Max-HP offense coexist")
 var before: int=g.enemy_health()
 WeaponCase.advance(g,int(attack.due)+1)
 check(g.enemy_health()==before-int(attack.stats.preview_strike_hp)-5,"the real ordinary hit consumes one native primary bonus without another proc")
 event=c.action(1,"form")
 var packet:={"vital_primary_bonus_hp":5}
 check(Vital.ordinary_bonus(event,packet)==5 and Vital.ordinary_bonus(event,packet)==0,"piercing, fan or repeated contacts cannot repeat a primary bonus")
 reset();c.equip(1,"vital")
 c.own(1,["verdant_reserve","verdant_reserve","verdant_reserve","verdant_reserve","living_reserves","living_reserves","living_reserves","living_reserves","flourishing_assault","flourishing_assault","flourishing_assault","flourishing_assault"],3)
 Vital.grant(g,c.action(1,"core"),1,0)
 attack=shot()
 check(p[Vitals.STATE].max_hp()==188 and attack.stats.vital_primary_bonus_hp==9,"twelve specialized copies yield real additional growth and nine primary damage without an arbitrary power cap")
 check(c.Catalog.effect_text(c.Catalog.DEFINITIONS.flourishing_assault,50).contains("0.5%"),"basis points render as the actual half-percent contribution")
 reset();c.equip(1,"vital",["form"]);c.own(1,["harvest"])
 Vital.grant(g,c.action(1,"form"),1,0)
 p[Vitals.STATE]=p[Vitals.STATE].with_hp(111)
 p[Protection.STATE]=p[Protection.STATE].grant(now+5000,1,Time.get_ticks_msec(),g.participation.epoch())
 var request:=Active.request(g,p,"harvest",Vector2.UP,100)
 Active.command(g,1,p,request);Active.command(g,1,p,request)
 check(Active.owner_state(g,p)[0].active and "On" in Active.owner_state(g,p)[0].name,"one accepted toggle is on; duplicate sequence cannot turn it off")
 attack=shot()
 check(p[Vitals.STATE].hp()==109 and p[Vitals.STATE].max_hp()==112 and attack.stats.vital_primary_bonus_hp==4,"launch spends two filled bonus HP once for four captured damage, preserving capacity")
 var expenditures:Array=g.combat_events.filter(func(row):return row.shape=="harvest_spend")
 check(expenditures.size()==1 and expenditures[0].kind=="ability" and expenditures[0].from==expenditures[0].to,"paid Harvest has one actor-local spending cue")
 check(p[Protection.STATE].charge_count()==1,"Harvest resource spending does not consume Ward or trigger incoming-hit defenses")
 var hp: float=p[Vitals.STATE].hp()
 check(not WeaponCase.start(g,1,p.pos) and p[Vitals.STATE].hp()==hp,"a refused repeated attack cannot spend more health")
 before=g.enemy_health();WeaponCase.advance(g,int(attack.due)+1)
 check(g.enemy_health()==before-int(attack.stats.preview_strike_hp)-4,"Harvest reaches the actual basic-hit resolver")
 p[Vitals.STATE]=p[Vitals.STATE].with_hp(100)
 attack=shot()
 check(p[Vitals.STATE].hp()==100 and attack.stats.vital_primary_bonus_hp==0 and Active.owner_state(g,p)[0].active,"empty bonus reserve suspends damage while keeping the toggle active and ordinary attacks functional")
 c.Clock.advance(g,1);Vital.tick(g,1000)
 attack=shot()
 check(p[Vitals.STATE].hp()==101 and attack.stats.vital_primary_bonus_hp==4,"native regeneration refills the reserve and resumes Harvest automatically")
 p[Vitals.STATE]=p[Vitals.STATE].with_hp(100.5)
 var original: Vitals.Health=p[Vitals.STATE]
 attack=shot()
 check(p[Vitals.STATE].hp()==100 and attack.stats.vital_primary_bonus_hp==1,"partial filled bonus HP converts only the half HP actually spent")
 p[Vitals.STATE]=original
 check(p[Vitals.STATE].hp()==100.5,"immutable health restoration rolls back expenditure exactly")
 for index in 16:Clock.step()
 Active.command(g,1,p,Active.request(g,p,"harvest",Vector2.UP,101))
 check(not Active.owner_state(g,p)[0].active and "Off" in Active.owner_state(g,p)[0].name,"a later authorized input explicitly turns Harvest off")
 attack=shot()
 check(p[Vitals.STATE].hp()==100.5 and attack.stats.vital_primary_bonus_hp==0,"disabled Harvest preserves bonus health for defense")
 reset();p.frame=4;p.weapon_kind=2
 var tree=g.Classes.connected_tree(4);p.character[tree.profile_key]=tree.state(["lifekeeper"])
 c.equip(1,"vital",["form"]);c.own(1,["harvest"])
 Vital.grant(g,c.action(1,"form"),1,0);p[Vitals.STATE]=p[Vitals.STATE].with_hp(110)
 Active.command(g,1,p,Active.request(g,p,"harvest",Vector2.UP,150))
 var left:=c.scout(Vector3(-.7,0,-2.3));var right:=c.scout(Vector3(.7,0,-2.3))
 attack=shot()
 WeaponCase.advance(g,int(attack.release)+1)
 check(p[Vitals.STATE].hp()==108 and g.weapon_attacks.views().size()>1,"a real Petal Fan volley spends only once across multiple projectiles")
 var end_at: int=attack.due
 for row in g.weapon_attacks.views():end_at=maxi(end_at,int(row.due))
 WeaponCase.advance(g,end_at+1)
 var damage: int=1000000-g.enemy_health()+10000-g.encounter.hp(left)+10000-g.encounter.hp(right)
 var contacts:=int(g.enemy_health()<1000000)+int(g.encounter.hp(left)<10000)+int(g.encounter.hp(right)<10000)
 check(contacts>0 and damage==contacts*int(attack.stats.preview_strike_hp)+4,"fan contacts share one captured Harvest bonus and generate no repeated secondary damage")
 reset();c.equip(1,"wood",["core"]);c.equip(1,"vital",["form"]);c.equip(1,"thorn",["catalyst"])
 c.own(1,["bloodletting","splinterburst","harvest"])
 check(Active.actions(p).size()==3,"three independently acquired active transformations coexist with B/Q/R")
 var wood=load("res://wood_affinity.gd")
 wood.grant(g,c.action(1,"core"),1,"combined")
 Vital.grant(g,c.action(1,"form"),1,0)
 var thorn=load("res://thorn_affinity.gd")
 thorn.patch(g,c.action(1,"catalyst"),g.tactics.position,1.0,now)
 Active.command(g,1,p,Active.request(g,p,"bloodletting",Vector2.UP,198))
 Active.command(g,1,p,Active.request(g,p,"splinterburst",Vector2.UP,199))
 Active.command(g,1,p,Active.request(g,p,"harvest",Vector2.UP,200))
 check(p[Active.STATE].actions.size()==3 and wood.capacity(wood.live_grants(p,0))==0 and Effects.read(g,-1).has(thorn.BLEED) and Active.owner_state(g,p).filter(func(row):return row.id=="harvest")[0].active,"all three active transformations execute with independent state, preserving shared Bleed and using actual Bark")
 p[Lifecycle.STATE]=p[Lifecycle.STATE].fall()
 var stale: Dictionary=p.get(Active.STATE,{}).duplicate(true)
 Active.command(g,1,p,Active.request(g,p,"harvest",Vector2.UP,201))
 check(p.get(Active.STATE,{})==stale,"fallen players cannot issue a new toggle")
 p[Lifecycle.STATE]=Lifecycle.start_life()
 check(not Active.owner_state(g,p).filter(func(row):return row.id=="harvest")[0].active,"revival invalidates the prior life's toggle")
 c.Cards.clear(p)
 check(Active.actions(p).is_empty() and not p.has(Active.STATE),"expedition cleanup removes acquired action state and ownership")
 Clock.end_stepped()
 g.queue_free();await process_frame
 if not failed:print("PASS: CE03 Vital ",checks," capacity, regeneration, primary damage, toggle, spending and lifecycle checks")
 quit(int(failed))
