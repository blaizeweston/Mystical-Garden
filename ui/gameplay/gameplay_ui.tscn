[node name="TitleConfirmation" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "End this expedition?"
dialog_text = "Leaving ends the expedition. Your run's Class XP, monster familiarity and carried items (including the safe pouch) will be forfeited. Courier deliveries and progression from earlier expeditions remain."
ok_button_text = "Return to Main Menu"

[node name="AbandonConfirmation" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Abandon this expedition?"
dialog_text = "Return to the Garden now? All carried seeds, materials, monster cargo and safe-pouch contents will be lost.\nNo expedition milestone, research or guardian-memory rewards will be granted.\nAll Class XP and monster familiarity earned this run, including earlier cleared floors, will be revoked. Courier deliveries and progression from earlier expeditions remain."
ok_button_text = "Abandon & return"
cancel_button_text = "Keep exploring"
