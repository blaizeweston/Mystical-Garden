theme_override_colors/font_color = Color(0.8980392156862745, 0.9294117647058824, 0.9176470588235294, 1)
theme_override_font_sizes/font_size = 16
text = "WASD / Arrows  Move   Space  Strike\nShift  Dodge   Q / R  Class skills\n\nGARDEN\nE at Heart: research and class upgrades\nE at Altar: identify and combine seeds or parts\nE at Wilds Gate: craft and depart\nE at plots: plant, inspect or harvest · F harvests seeds\nE at Garden water: fill watering vessel after Root Irrigation\nI: inventory · O: inspect progression\n\nWILDS\nE: collect loot, use grafting altars or continue at the gate\nT: extract at every sixth cleared gate\nEsc: menu / abandon expedition"
custom_minimum_size = Vector2(330, 0)
autowrap_mode = 3

