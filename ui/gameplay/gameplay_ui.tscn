theme_override_colors/font_color = Color(0.8313725490196079, 0.8431372549019608, 0.7098039215686275, 1)
theme_override_font_sizes/font_size = 16
text = "Every root has found its lost memory. The civilization, the corruption, the sacrifice: the Heart remembers it all.\n\nIt remembers what it protected. It remembers what people asked of it. And now it fears the Garden will repeat that ending.\n\nIts final remembrance is awake. Prepare your weapon, then face the Heart."
custom_minimum_size = Vector2(520, 0)
autowrap_mode = 3

