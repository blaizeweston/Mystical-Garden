static func signatures() -> Dictionary:
	var result := {}
	for entry in ENTRIES:
		result[entry.species] = {"tag": entry.tag, "skill": entry.id}
	return result


static func skills() -> Array:
	var result := []
	for entry in ENTRIES:
		var skill: Dictionary = entry.duplicate(true)
		var arc: bool = entry.has("contact")
		skill.mechanic = "swept_projectile" if arc else "ground_sequence"
		skill.range_key = "lance_range" if arc else "range"
		skill.icon = "res://assets/ui/core_skills/%s.png" % entry.id
		skill.trigger_description = entry.desc
		skill.delivery_text = {
			"ground": "Send a spark in the direction you aim." if arc else "Plant the Core effect on aimed ground.",
			"arrow": "Fire a seed arrow carrying the spark." if arc else "Fire a seed arrow that plants the effect on impact.",
			"bolt": "Fire a seed bolt carrying the spark." if arc else "Fire a seed bolt that plants the effect on impact.",
			"seed": "Send a seed carrying the spark." if arc else "Send a seed that plants the effect where it lands.",
		}
		for key in ["species", "tag", "desc", "form", "catalyst", "card", "graft", "secondary"]:
			skill.erase(key)
		result.append(skill)
	return result


static func interactions() -> Array:
	var result := []
	for entry in ENTRIES:
		for slot in ["secondary", "form", "catalyst", "graft"]:
			if not entry.has(slot):
				continue
			var tuning: Array = entry[slot]
			result.append({"id": entry.id + "_" + slot, "skill": entry.id, "slot": slot, "tag": tuning[0], "text": tuning[1], "values": tuning[2]})
	return result


const STARTER_CARDS := [
	["seed_lance", "piercing", "Deep Seed", "The first enemy struck is rooted.", {"root_ms": 1200}],
	["lantern_burst", "luminous", "Living Light", "The flash wards living allies in the circle against their next hit.", {"area_guard_ms": 2100}],
	["whisper_mark", "whisper_mark", "Binding Whisper", "The direct hit that bursts the mark also roots the enemy.", {"mark_root_ms": 1200}],
	["constellation", "constellation", "Starfall", "The beam deals damage to each enemy it roots.", {"beam_damage": 2}],
]


static func cards() -> Array:
	var result := []
	for entry in STARTER_CARDS:
		result.append(card(entry[0], entry[1], entry[2], entry[3], entry[4]))
	for entry in ENTRIES:
		result.append(card(entry.id, entry.tag, entry.card[0], entry.card[1], entry.card[2]))
	return result


static func card(skill: String, tag: String, title: String, description: String, tuning: Dictionary) -> Dictionary:
	return {"id": "core_" + skill, "name": title, "description": description,
		"rarity": "Rare", "cost": 4, "weight": 1.5, "max_rank": 1, "effects": {},
		"core": {"skill": skill, "slots": {"primary": [tag]}}, "core_tuning": tuning}

